{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SherlockPC",
  "version": "0.1.0",
  "identifier": "dev.sherlockpc.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SherlockPC",
        "width": 1360,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Evidence-driven local PC investigator"
  }
}
