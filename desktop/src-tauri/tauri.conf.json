{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SherlockPC",
  "version": "0.1.0",
  "identifier": "io.github.fireaideveloper.sherlockpc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SherlockPC — Observe & Investigate",
        "width": 1200,
        "height": 760,
        "minWidth": 820,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "publisher": "fireaideveloper",
    "homepage": "https://github.com/fireaideveloper/SherlockPC",
    "copyright": "Copyright © 2026 fireaideveloper",
    "shortDescription": "Evidence-driven local PC investigator",
    "longDescription": "SherlockPC is a local-first Windows desktop investigator that captures system evidence, evaluates bounded diagnostic hypotheses and shows a traceable investigation result.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/sherlock-backend"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "SherlockPC",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
